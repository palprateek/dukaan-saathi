# Dukaan Saathi runs fully offline with its built-in Hinglish engine.
# Add a Gnani API key to route Prisma (speech → text) and Timbre (text → speech)
# through Gnani. Evon (understanding) needs an endpoint as well.
# Docs: https://docs.gnani.ai/api/introduction/introduction

# Gnani API key from https://app.gnani.ai/voice — sent as X-API-Key-ID.
GNANI_API_KEY=

# Base URL for the speech APIs (default https://api.vachana.ai)
# GNANI_BASE_URL=https://api.vachana.ai

# Prisma STT. Default endpoint is POST https://api.vachana.ai/stt/v3
# GNANI_PRISMA_URL=
# prisma-v3.0 handles mixed Hinglish and supports keyterms/topic.
# Use prisma-v2.5 for a single-language deployment.
# GNANI_PRISMA_MODEL=prisma-v3.0

# Timbre TTS. Default endpoint is POST https://api.vachana.ai/api/v1/tts/inference
# GNANI_TIMBRE_URL=
# GNANI_TIMBRE_MODEL=timbre-v2.5
# Poorvi is Gnani's Hinglish voice.
# GNANI_TIMBRE_VOICE=Poorvi

# Evon (language model) understanding endpoint. There is no public
# transactional extraction API, so point this at your Evon deployment or a
# proxy that returns the contract in README → "Gnani integration".
GNANI_EVON_URL=

# Language hint(s): hi-IN for Prisma v2.5; hi-IN,en-IN for v3 code-mixed.
GNANI_LANGUAGE=hi-IN,en-IN

# Local server port
PORT=8787
